# Copie este arquivo para .env e preencha TODOS os valores.
# .env é gitignored.
#
# Para gerar segredos fortes use, por exemplo:
#   openssl rand -hex 32

# ----- PostgreSQL -----
POSTGRES_USER=facegate
# CHANGE BEFORE DEPLOY
POSTGRES_PASSWORD=troca_isso
POSTGRES_DB=facegate

# DATABASE_URL é consumida pelo backend. No docker-compose o host é
# o nome do serviço Postgres (`postgres`). Para `cargo run` local
# substitua por `localhost`.
DATABASE_URL=postgresql://facegate:troca_isso@postgres:5432/facegate

# ----- JWT -----
# CHANGE BEFORE DEPLOY (gerar com `openssl rand -hex 32`)
JWT_SECRET=gera_uma_chave_aleatoria_longa_aqui

# ----- MQTT (lado backend) -----
# Hostname do broker. No docker-compose é o nome do serviço; numa Pi
# rodando contra um broker remoto é o IP público da EC2.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Usuário usado pelo backend para se autenticar contra o broker.
# CHANGE BEFORE DEPLOY
MQTT_USERNAME=backend
MQTT_PASSWORD=troca_isso_backend

# ----- MQTT (lado edge / Pi) -----
# Usuário separado do backend. Senha entra no config.toml da Raspberry.
# CHANGE BEFORE DEPLOY
EDGE_MQTT_USERNAME=edge-pi
EDGE_MQTT_PASSWORD=troca_isso_pi

# ----- CORS -----
# Lista de origins permitidos pelo backend. Em produção (Caddy faz reverse
# proxy same-origin) o backend nem precisa lidar com CORS via browser,
# mas mantemos a allow-list para chamadas diretas em testes (`curl`,
# Postman) e qualquer caso onde alguém aponte o painel direto para :3000.
#
# Padrão local: dev no laptop ouvindo em 8100. Em EC2 sem domínio,
# trocar pelo IP público da instância.
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100
